{$SITE_DOMAIN} {
	encode zstd gzip
	# Public API for institutions (keys and rate limits enforced by the engine).
	handle /v1/* {
		reverse_proxy api:8000
	}
	# Everything else is the website. The engine's internal /api stays private:
	# the website reaches it over the Docker network only.
	handle {
		reverse_proxy web:3000
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
