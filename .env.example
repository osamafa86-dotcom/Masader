# --- required ---
SITE_DOMAIN=marsad.example.org
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Encrypts stored two-step verification secrets. Generate once: python -c "import secrets; print(secrets.token_urlsafe(48))"
MARSAD_SECRET_KEY=change-me
# Claude API key used by the worker for classification, summaries and translation.
ANTHROPIC_API_KEY=

# --- editorial policy (defaults shown) ---
MARSAD_SITE_NAME=مصادر
NEXT_PUBLIC_SITE_NAME=مصادر
MARSAD_SITE_URL=https://marsad.example.org
MARSAD_CONTACT_EMAIL=editor@example.org
# Set to true if the site carries ads or paid membership: CC BY-NC sources then drop to summary-only.
MARSAD_SITE_COMMERCIAL=false
MARSAD_DAILY_BUDGET_USD=15
# Items at or above this importance (1-5) always need an editor's approval.
MARSAD_REVIEW_MIN_IMPORTANCE=3
# Allow lower-importance items without QA problems to publish with a "machine translation" label.
MARSAD_AUTO_PUBLISH=false
# Second-opinion review of each translation by another model (adds roughly 30% to translation cost).
MARSAD_QA_LLM_JUDGE=false
# Translate items of importance <= 3 through the Message Batches API at half price (results within hours).
MARSAD_BATCH_ENABLED=true
MARSAD_BATCH_MAX_IMPORTANCE=3

# --- security and monitoring ---
# Require every editor to set up two-step verification before using the dashboard.
MARSAD_REQUIRE_EDITOR_2FA=true
# Operational alerts (stopped worker, failing sources, budget) go to these addresses.
MARSAD_ALERT_EMAILS=
# Optional error tracking (install the engine with the [sentry] extra).
MARSAD_SENTRY_DSN=

# --- models (defaults shown) ---
MARSAD_MODEL_TRANSLATE=claude-opus-5-5
MARSAD_MODEL_SUMMARIZE=claude-opus-5-5
MARSAD_MODEL_CLASSIFY=claude-haiku-5-5
MARSAD_MODEL_JUDGE=claude-sonnet-5-5

# --- semantic search (optional) ---
# Voyage AI key for multilingual embeddings. Without it, search and related items use keywords and tags.
MARSAD_VOYAGE_API_KEY=
MARSAD_EMBED_MODEL=voyage-3.5
MARSAD_SEMANTIC_MIN_SIMILARITY=0.35

# --- newsletter (optional) ---
# Any SMTP provider (Postmark, Amazon SES, Resend, Mailgun...). Without a host the subscribe form is disabled.
MARSAD_SMTP_HOST=
MARSAD_SMTP_PORT=587
MARSAD_SMTP_USER=
MARSAD_SMTP_PASSWORD=
MARSAD_SMTP_FROM=مصادر <newsletter@marsad.example.org>
MARSAD_MAIL_BATCH=50

BACKUP_KEEP_DAYS=14
